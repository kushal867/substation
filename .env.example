# --- Required for the admin panel -------------------------------------------
# PostgreSQL connection string (same database the n8n workflows use)
DATABASE_URL=postgres://shop2_app:CHANGE_ME@127.0.0.1:5432/shop2

# Random string, at least 32 characters, used to sign admin sessions.
#   openssl rand -base64 48
SESSION_SECRET=

# Admin password. Prefer the hash: npm run admin:hash -- "your strong password"
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=   # plain-text fallback (not recommended)

# Set to 1 ONLY if you serve the admin over plain http (e.g. testing on localhost in production mode)
# INSECURE_COOKIES=1
